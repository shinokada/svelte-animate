{
  "name": "svelte-animate",
  "version": "0.6.2",
  "description": "A lightweight Svelte component that adds beautiful CSS animations to any element using Animate.css library. Features include click/hover triggers, customizable duration, reduced motion support, and accessibility features. Perfect for creating engaging user interfaces with smooth animations in Svelte applications.",
  "keywords": [
    "svelte",
    "animation",
    "animate.css",
    "web animation",
    "UI components",
    "front-end development",
    "svelte animations",
    "CSS animations",
    "user interface",
    "accessibility",
    "UI/UX",
    "motion effects",
    "transition effects",
    "animation library",
    "svelte transitions"
  ],
  "license": "MIT",
  "homepage": "https://svelte-animate.codewithshin.com/",
  "author": {
    "name": "Shinichi Okada",
    "url": "https://codewithshin.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinokada/svelte-animate.git"
  },
  "bugs": "https://github.com/shinokada/svelte-animate/issues",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "package": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "gen:exports": "svelte-lib-helpers exports",
    "gen:docs5": "svelte-lib-helpers docs5",
    "gen:docs5FromType": "svelte-lib-helpers docs5FromType",
    "copy:packagejson": "svelte-lib-helpers package",
    "lib-helpers": "pnpm format && pnpm gen:docs5 && pnpm build && pnpm copy:packagejson",
    "ch": "npx changeset",
    "cv": "npx changeset version",
    "cp": "npx changeset publish"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "runatics": "^0.3.0",
    "runes-meta-tags": "^0.5.1",
    "runes-webkit": "^0.12.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-lib-helpers": "^0.4.31",
    "svelte-rune-highlight": "^0.12.1",
    "svelte-shields": "^0.5.4",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "animate.css": "^4.1.1"
  }
}
